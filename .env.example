# Copy to .env.local for development. Never commit real secrets.

# Public site URL used for canonical links and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Development mock data. Omitted in development means mock data is on.
# Production ignores this flag and always uses Supabase.
NEXT_PUBLIC_USE_MOCK_DATA=true

# Supabase. Required when mock data is off, and required in production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay. Leave empty to use the labelled sandbox outside production.
# Production with missing keys or PAYMENT_MODE=sandbox stays unconfigured.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_MODE=sandbox

# Cashfree webhook verification. Checkout creation is not implemented.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=

# Salt for visitor hashes. Production skips analytics recording when this is empty.
ANALYTICS_SALT=

# Bearer token for POST /api/cron/daily.
CRON_SECRET=

# Production admin routes require Supabase MFA (aal2) unless this is false.
REQUIRE_ADMIN_MFA=true

# Optional error monitor. Events are not sent unless you add a client.
SENTRY_DSN=
